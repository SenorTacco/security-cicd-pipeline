# Bu dosyayi .env olarak kopyalayip gercek degerleri girin
# .env dosyasi ASLA commit edilmemelidir!

AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
DATABASE_PASSWORD=your-db-password-here
API_SECRET_KEY=your-flask-secret-key-here
DEBUG_MODE=false

# SQLite veritabani dosya yolu (Docker'da volume'e bagli dizin kullanin)
DATABASE_PATH=app.db
